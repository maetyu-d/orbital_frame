{"format": "of:: Project", "version": 1, "rate": 1.0, "masterGain": 0.95, "projectStateCount": 6, "selectedProjectState": 0, "fabricStateProgram": "start state 1 from bar 0\nplay selected for 8 bars\nafter 8 bars -> state 2 from bar 0\nplay selected for 16 bars\nafter 16 bars -> state 3 from bar 1\nplay selected for 14 bars\nafter 14 bars -> state 4 from bar 0\nplay selected for 16 bars\nafter 16 bars -> state 5 from bar 0\nplay selected for 9 bars\nafter 9 bars -> state 6 from bar 0\nplay selected for 12 bars\nafter 12 bars -> random state 1..6 from bar 0\nplay selected for 16 bars\nloop\n", "machine": {"machineId": "melodic_state_1", "lanePrefix": "mel-s1-", "timingMode": "follow", "parentDivision": 1, "selectedState": 0, "selectedLane": 0, "entryState": 0, "states": [{"name": "Track 1 / Moss bass", "tempoBpm": 92.0, "beatsPerBar": 5, "beatUnit": 4, "arrangementBars": 10, "arrangementBeats": 0, "durationUsesSeconds": false, "durationSeconds": 32.608695652173914, "orbitWarp": [0.00179999996908, -0.005400000140071, 0.006750000175089, -0.00179999996908, 0.005400000140071, -0.004050000105053, 0.00089999998454, -0.004499999806285], "lanes": [{"id": "mel-s1-t0-l0", "name": "Moss bass main", "script": "(\n{\n    |gate = 1, fade = 0.01, vol = 1|\n\n    var bpm = ((~ofTempoHz ? ~markovTempoHz ? (96 / 60)) * 60).clip(30, 240);\n    var tempo = (bpm / 60).max(0.05);\n    var root = NamedControl.kr(\\root, 43);\n    var trig = Impulse.kr(tempo / 2);\n    var stepIndex = (PulseCount.kr(trig) - 1).max(0);\n    var degree = Select.kr(stepIndex % 8, [0, 0, 7, 3, 5, 2, 10, 7]);\n    var octave = Select.kr((stepIndex / 4).floor % 4, [0, -12, 0, 12]);\n    var note = (root + degree + octave).clip(20, 96);\n    var env = EnvGen.kr(Env.asr(fade.max(0.002), 1, fade.max(0.01)), gate, doneAction: 2);\n    var pluck = Decay2.kr(trig, 0.006, 0.18);\n    var sig = (Saw.ar(note.midicps * [0.5, 1.0]) * 0.18) + (SinOsc.ar(note.midicps * 0.5) * 0.42);\n    sig = LPF.ar(sig, 220 + (pluck * 1200));\n    sig = LeakDC.ar(sig) * (0.42 + (pluck * 0.58)) * env;\n\n    Limiter.ar(Splay.ar(sig, 0.18) * vol, 0.82);\n}.play;\n)\n", "volume": 0.579999983310699, "gain": 0.899999976158142, "pan": 0.0, "enabled": true, "muted": false, "solo": false, "frozen": true, "freezeStale": false, "frozenAudioPath": "of-demo-melodic-constellation Media/Freezes/mel-s1-t0-l0.wav", "frozenDurationSeconds": 32.608695652173914, "sourceScriptPath": "/Users/user/Documents/Orbits/demos/sc/of-melodic-orbit-bass.scd", "orbitPhase": 0.0, "durationMode": "bars", "durationValue": 10.0, "fadeInSeconds": 0.0, "fadeOutSeconds": 0.02}, {"id": "mel-s1-t0-l1", "name": "Moss bass answer", "script": "(\n{\n    |gate = 1, fade = 0.005, vol = 1|\n\n    var bpm = ((~ofTempoHz ? ~markovTempoHz ? (108 / 60)) * 60).clip(30, 260);\n    var tempo = (bpm / 60).max(0.05);\n    var root = NamedControl.kr(\\root, 60);\n    var rateMul = NamedControl.kr(\\rateMul, 1.5);\n    var trig = Impulse.kr(tempo * rateMul);\n    var stepIndex = (PulseCount.kr(trig) - 1).max(0);\n    var degree = Select.kr(stepIndex % 12, [0, 7, 10, 14, 12, 7, 5, 3, 0, 12, 15, 19]);\n    var octave = Select.kr(stepIndex % 6, [0, 0, 12, 0, -12, 0]);\n    var note = (root + degree + octave).clip(24, 108).midicps;\n    var exc = PinkNoise.ar(0.22) * Decay2.kr(trig, 0.002, 0.05);\n    var tone = Ringz.ar(exc, note * [1, 2.01, 3.01], [0.34, 0.19, 0.11]).sum;\n    var env = EnvGen.kr(Env.asr(fade.max(0.002), 1, fade.max(0.01)), gate, doneAction: 2);\n    var sig = HPF.ar(tone, 160) * env;\n    sig = CombC.ar(sig, 0.32, [0.19, 0.23], 1.8) * 0.18 + sig;\n\n    Limiter.ar(Splay.ar(sig, 0.55) * vol, 0.72);\n}.play;\n)\n", "volume": 0.340000003576279, "gain": 0.779999971389771, "pan": -0.319999992847443, "enabled": true, "muted": false, "solo": false, "frozen": true, "freezeStale": false, "frozenAudioPath": "of-demo-melodic-constellation Media/Freezes/mel-s1-t0-l1.wav", "frozenDurationSeconds": 16.304347826086957, "sourceScriptPath": "/Users/user/Documents/Orbits/demos/sc/of-melodic-glass-pluck.scd", "orbitPhase": 0.333000004291534, "durationMode": "bars", "durationValue": 5.0, "fadeInSeconds": 0.0, "fadeOutSeconds": 0.02}, {"id": "mel-s1-t0-l2", "name": "Moss bass shimmer", "script": "(\n{\n    |gate = 1, fade = 0.12, vol = 1|\n\n    var bpm = ((~ofTempoHz ? ~markovTempoHz ? (72 / 60)) * 60).clip(30, 200);\n    var tempo = (bpm / 60).max(0.05);\n    var root = NamedControl.kr(\\root, 50);\n    var shiftTrig = Impulse.kr(tempo / 6);\n    var stepIndex = (PulseCount.kr(shiftTrig) - 1).max(0);\n    var shift = Select.kr(stepIndex % 6, [0, 5, 3, -2, 7, 3]);\n    var notes = (root + shift + [0, 3, 7, 10, 14]).clip(24, 108).midicps;\n    var env = EnvGen.kr(Env.asr(fade.max(0.03), 1, fade.max(0.06)), gate, doneAction: 2);\n    var sig = Formant.ar(notes, notes * [1.6, 1.35, 1.42, 1.28, 1.55], notes * 0.22, 0.045).sum;\n    sig = LPF.ar(sig, SinOsc.kr(tempo / 18).range(900, 3400));\n    sig = FreeVerb2.ar(sig, DelayC.ar(sig, 0.04, 0.019), 0.35, 0.72, 0.35);\n\n    Limiter.ar(LeakDC.ar(sig) * env * vol, 0.76);\n}.play;\n)\n", "volume": 0.280000001192093, "gain": 0.720000028610229, "pan": 0.379999995231628, "enabled": true, "muted": false, "solo": false, "frozen": true, "freezeStale": false, "frozenAudioPath": "of-demo-melodic-constellation Media/Freezes/mel-s1-t0-l2.wav", "frozenDurationSeconds": 9.782608695652176, "sourceScriptPath": "/Users/user/Documents/Orbits/demos/sc/of-melodic-soft-choir.scd", "orbitPhase": 0.666999995708466, "durationMode": "bars", "durationValue": 3.0, "fadeInSeconds": 0.08, "fadeOutSeconds": 0.12}]}, {"name": "Track 2 / Glass path", "tempoBpm": 95.0, "beatsPerBar": 5, "beatUnit": 4, "arrangementBars": 10, "arrangementBeats": 0, "durationUsesSeconds": false, "durationSeconds": 31.578947368421051, "orbitWarp": [0.00359999993816, -0.008100000210106, 0.002249999903142, -0.00359999993816, 0.008100000210106, -0.001350000035018, 0.00179999996908, -0.006750000175089], "lanes": [{"id": "mel-s1-t1-l0", 